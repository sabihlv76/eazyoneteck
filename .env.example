# Copy to .env and fill in real values. Never commit .env.

# MongoDB
MONGODB_URI=
MONGODB_DB=

# Cloudinary (dashboard home -> Cloud name / API Key / API Secret)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin bootstrap (used only when the settings collection is empty)
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PIN=
